{
  "name": "sse-inspector",
  "version": "1.0.0",
  "description": "vLLM/OpenAI-compatible API proxy with SSE recording and inspection",
  "license": "MIT",
  "main": "dist/index.js",
  "bin": {
    "sse-inspector": "bin/sse-inspector.js"
  },
  "type": "commonjs",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "files": [
    "bin/",
    "dist/",
    "frontend/dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/sse-inspector.js --dev",
    "build": "tsc",
    "build:frontend": "npm --prefix frontend run build",
    "build:all": "npm run build && npm run build:frontend",
    "prepack": "npm run build:all",
    "test:sse": "tsx backend/test/sse-merger.test.ts",
    "test:decode": "tsx backend/test/body-decode.test.ts",
    "test:endpoints": "tsx backend/test/endpoint-tools.test.ts",
    "test:usage": "tsx backend/test/api-usage.test.ts",
    "test:preview": "tsx backend/test/store-preview.test.ts",
    "test:response-flow": "tsx frontend/test/response-flow.test.ts",
    "test:proxy": "tsx backend/test/proxy-data-plane.test.ts",
    "test:worker": "tsx backend/test/recorder-worker.test.ts",
    "test:ui-buffer": "tsx backend/test/ui-event-buffer.test.ts",
    "test:shutdown": "tsx backend/test/recorder-client-shutdown.test.ts",
    "test:capture-queue": "tsx backend/test/recorder-capture-queue.test.ts",
    "test:token-speed": "tsx frontend/test/token-speed.test.ts",
    "test:context": "tsx frontend/test/context-composition.test.ts",
    "test:logger": "tsx backend/test/logger.test.ts",
    "test:cli-logging": "tsx backend/test/cli-logging.test.ts",
    "test:all": "npm run test:sse && npm run test:decode && npm run test:endpoints && npm run test:usage && npm run test:preview && npm run test:response-flow && npm run test:proxy && npm run test:worker && npm run test:ui-buffer && npm run test:shutdown && npm run test:capture-queue && npm run test:token-speed && npm run test:context && npm run test:logger && npm run test:cli-logging && tsx backend/test/db-logger.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.1",
    "compression": "^1.8.1",
    "eventsource-parser": "^3.1.0",
    "express": "^4.21.0",
    "httpxy": "0.5.5",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.3",
    "vite": "^8.0.16",
    "vite-express": "^0.22.1"
  },
  "private": true
}
